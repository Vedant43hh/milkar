# --- Database (docker compose up -d) ---
DATABASE_URL="postgresql://milkar:milkar@localhost:5433/milkar?schema=public"
# Used only by `npm run test:int`. Never point this at a database you care about: tests truncate it.
TEST_DATABASE_URL="postgresql://milkar:milkar@localhost:5433/milkar_test?schema=public"

# --- App ---
APP_URL="http://localhost:3000"

# --- Auth ---
# "mock": any 6 digits are accepted and the generated code is logged to the server console.
# The server refuses to boot with OTP_MODE=mock in production unless DEMO_MODE=true.
OTP_MODE="mock"
# Shows one-click logins for the seeded demo users on /login.
DEMO_MODE="true"

# OTP rate limits (defaults shown)
OTP_LIMIT_PHONE_15M="3"
OTP_LIMIT_PHONE_DAY="10"
OTP_LIMIT_IP_15M="30"
OTP_LIMIT_IP_DAY="200"

# --- Cron ---
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" automatically when this is set.
CRON_SECRET="dev-cron-secret-change-me"
# The server runs the jobs itself (cutoff, reminders, expired holds) every N seconds; 0 turns it off.
# Fine for one long-running server; on serverless hosting call GET /api/cron from a scheduler instead.
CRON_TICK_SECONDS="60"

# --- Payments (optional) ---
# Leave empty to use the built-in mock UPI provider.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# --- Invoice (optional) ---
PLATFORM_GSTIN=""

# --- Notifications ---
# In-app notifications are always stored. Push and SMS are stubs: "log" prints what they would send.
NOTIFY_STUBS="log"
